# ==============================================================================
# Containerfile - Leptos Frontend (WASM), served by nginx
# Built with Podman:
#   podman build -f containers/Containerfile.frontend -t drone-convoy-tracker-frontend .
#
# RUST_VERSION MUST BE >= 1.85 -- the workspace is edition 2024.
#
# ------------------------------------------------------------------------------
# CROSS-ARCHITECTURE
#
# Single architecture, for local work:
#   podman build -f containers/Containerfile.frontend \
#     -t drone-convoy-tracker-frontend:dev .
#
# Both architectures, for a registry:
#   podman build --platform linux/amd64,linux/arm64 \
#     --manifest drone-convoy-tracker-frontend:v1 \
#     -f containers/Containerfile.frontend .
#   podman manifest push --all drone-convoy-tracker-frontend:v1 \
#     docker://<registry>/drone-convoy-tracker-frontend:v1
#
# THE BUILD STAGE IS PINNED TO THE BUILD MACHINE'S ARCHITECTURE, ON PURPOSE.
# See the note on stage 1 -- it is the difference between a two-minute build and
# a forty-minute one on Apple silicon.
# ==============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build WASM
#
# --platform=$BUILDPLATFORM pins this stage to the machine doing the building,
# NOT to the image's target architecture.
#
# That is correct here, and it is not a shortcut: everything this stage emits is
# architecture-neutral. The Leptos output is wasm32-unknown-unknown bytecode
# plus static HTML, CSS and assets -- identical bytes whether compiled on arm64
# or amd64.
#
# Without this line, building a linux/amd64 image on an Apple silicon Mac runs
# rustc, trunk and wasm-bindgen under QEMU emulation to produce an artifact that
# does not depend on the architecture at all. Expect roughly an order of
# magnitude in wall-clock time for nothing.
#
# The runtime stage below is NOT pinned, so nginx is still fetched for the
# target architecture. Only the compiler runs native.
# -----------------------------------------------------------------------------
ARG RUST_VERSION=1.89
FROM --platform=$BUILDPLATFORM docker.io/library/rust:${RUST_VERSION}-slim-bookworm AS builder

ARG BUILDPLATFORM
ARG TARGETPLATFORM

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Trunk and wasm-bindgen.
#
# Deliberately compiled from source rather than downloaded as release binaries.
# Prebuilt trunk and wasm-bindgen tarballs are published per architecture, and a
# hardcoded x86_64 URL is the single most common way a Rust Containerfile breaks
# on arm64. `cargo install` sidesteps that entirely -- it builds for whatever
# architecture it is running on.
#
# NOTE ON VERSIONS: wasm-bindgen-cli must match the wasm-bindgen crate version
# in Cargo.lock, or trunk fails with a version-mismatch error. Left unpinned
# because pinning the wrong version breaks the build outright; if this ever
# starts failing after a lock update, pin both to the same version here.
RUN cargo install trunk wasm-bindgen-cli

# Add WASM target
RUN rustup target add wasm32-unknown-unknown

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build frontend
WORKDIR /app/crates/drone-frontend
RUN trunk build --release

# -----------------------------------------------------------------------------
# Stage 2: Nginx Runtime
#
# No --platform, deliberately: this stage MUST match the target architecture,
# which is the default behaviour. nginx:alpine is published multi-arch.
# -----------------------------------------------------------------------------
FROM docker.io/library/nginx:1.27-alpine AS runtime

# Copy nginx config
COPY containers/nginx.conf /etc/nginx/nginx.conf

# Copy built assets. Architecture-neutral (wasm32 + static files), which is what
# lets the builder stage run native.
COPY --from=builder /app/crates/drone-frontend/dist /usr/share/nginx/html

# Security headers
RUN echo 'add_header X-Frame-Options "SAMEORIGIN" always;' >> /etc/nginx/conf.d/security.conf && \
    echo 'add_header X-Content-Type-Options "nosniff" always;' >> /etc/nginx/conf.d/security.conf && \
    echo 'add_header X-XSS-Protection "1; mode=block" always;' >> /etc/nginx/conf.d/security.conf

EXPOSE 80

# ---------------------------------------------------------------------------
# CHANGED FROM curl TO wget -- and this is a bug fix, not an architecture one.
#
# nginx:alpine is busybox-based and does NOT ship curl. The previous
# `CMD curl -f http://localhost/` could never succeed: every container reported
# `unhealthy` from the first check onward, on every architecture. busybox wget
# is present in the image, so this actually runs.
#
# Revert if you would rather install curl instead -- but do not leave the
# original, it is a guaranteed-failing healthcheck.
#
# The same applies to the `frontend` healthcheck in podman-compose.yml, which
# is fixed there for the same reason.
# ---------------------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --spider -q http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
